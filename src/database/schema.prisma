generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String?
}

model FileUpload {
  id        Int    @id @default(autoincrement())
  fileName  String
  contents  Bytes
}