generator client {
  provider = "prisma-client"
  output   = "./generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    Int    @id @default(autoincrement())
  name  String
  email String @unique
  phone String?
}

model FileUpload {
  id        Int    @id @default(autoincrement())
  fileName  String
  contents  Bytes
}

model EventInbox {
  id          Int   @id @default(autoincrement())
  eventType   String
  createdDate DateTime
  Payload     Json
}
